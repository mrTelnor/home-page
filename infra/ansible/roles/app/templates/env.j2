# PostgreSQL
POSTGRES_USER={{ vault_postgres_user }}
POSTGRES_PASSWORD={{ vault_postgres_password }}
POSTGRES_DB={{ vault_postgres_db }}

# Domain
DOMAIN={{ vault_domain }}
SITE_URL=https://{{ vault_domain }}
ACME_EMAIL={{ vault_acme_email }}

# IP whitelist for admin panels
HOME_IP={{ vault_home_ip }}

# Backend
DATABASE_URL=postgresql+asyncpg://{{ vault_postgres_user }}:{{ vault_postgres_password }}@postgres:5432/{{ vault_postgres_db }}
JWT_SECRET={{ vault_jwt_secret }}
INVITE_CODE={{ vault_invite_code }}
CRON_SECRET={{ vault_cron_secret }}
TELEGRAM_BOT_TOKEN={{ vault_telegram_bot_token }}
TELEGRAM_BOT_USERNAME={{ vault_telegram_bot_username }}
BOT_SECRET={{ vault_bot_secret }}
UPTIME_SECRET={{ vault_uptime_secret }}
# Вики: чтение базы знаний (Supabase) ролью wiki_reader через пулер (session).
# Пусто = вики выключена. Состав переменных проверяет assert в tasks/main.yml.
# urlencode оставляет «/» как есть — в пароле его надо кодировать отдельно.
{% if vault_wiki_db_host | default('') %}
WIKI_DATABASE_URL=postgresql+asyncpg://{{ vault_wiki_db_user }}:{{ vault_wiki_db_password | urlencode | replace('/', '%2F') }}@{{ vault_wiki_db_host }}:{{ vault_wiki_db_port }}/postgres
{% else %}
WIKI_DATABASE_URL=
{% endif %}

# Email (сброс пароля через RuSender)
RUSENDER_API_KEY={{ vault_rusender_api_key }}
RUSENDER_KEY_ID={{ vault_rusender_key_id }}
EMAIL_FROM={{ vault_email_from | default('Telnor <noreply@telnor.ru>') }}

# Yandex.Disk backup
YADISK_USER={{ vault_yadisk_user }}
YADISK_APP_PASSWORD={{ vault_yadisk_app_password }}
# Dead-man's-switch: ping-URL монитора (healthchecks.io) — пингуется только при
# успешном бэкапе; монитор сам алертит, если пинга не было. Пусто = выключено.
HEARTBEAT_URL={{ vault_heartbeat_url | default('') }}

# Google Calendar integration (bot)
GOOGLE_SERVICE_ACCOUNT_B64={{ vault_google_service_account_b64 }}
CALENDAR_CONFIGS={{ vault_calendar_configs | from_json | to_json }}
# Дефолтные напоминания (минуты, через запятую) — для событий без explicit overrides
CALENDAR_DEFAULT_REMINDERS_MIN={{ calendar_default_reminders_min | default('30') }}

# Vikunja (трекер задач, tracker.<domain>)
VIKUNJA_DB_PASSWORD={{ vault_vikunja_db_password }}
VIKUNJA_SERVICE_SECRET={{ vault_vikunja_service_secret }}
# Регистрация открывается только на время заведения учёток: -e vikunja_enable_registration=true
VIKUNJA_ENABLE_REGISTRATION={{ (vikunja_enable_registration | default(false) | bool) | lower }}
# Почта трекера — SMTP RuSender (хост/порт — в docker-compose.yml)
VIKUNJA_SMTP_USERNAME={{ vault_vikunja_smtp_username }}
VIKUNJA_SMTP_PASSWORD={{ vault_vikunja_smtp_password }}
# Только адрес: Vikunja оборачивает его в "Vikunja <...>"
VIKUNJA_MAILER_FROMEMAIL={{ (vault_email_from | default('Telnor <noreply@telnor.ru>')) | regex_replace('^.*<([^>]+)>.*$', '\\1') }}
# Уведомления трекера в Telegram (bot, /vikunja-webhook). Пустой секрет — webhook отклоняется.
VIKUNJA_WEBHOOK_SECRET={{ vault_vikunja_webhook_secret | default('') }}
# Логин Vikunja → логин telnor.ru (JSON-строка в vault)
VIKUNJA_USER_MAP={{ vault_vikunja_user_map | from_json | to_json }}
