# Логи задач пишутся в /var/log/cron.log внутри контейнера
# (`docker exec cron cat /var/log/cron.log`).
# ВАЖНО: НЕ редиректить в /proc/1/fd/1 — busybox crond (Alpine) отвергает
# такой redirect («redir error») и НЕ выполняет саму команду — ломает все задачи.
#
# Все curl — с --fail и ретраями: раньше `curl -s` считал 500 успехом, и цепочка
# `&&` слала уведомление о меню, которого нет. При провале шага — алерт админам
# через cron-alert.sh; конструкция `|| { alert; false; }` останавливает цепочку.

# Бэкап БД + фото рецептов на Яндекс.Диск (3:00 GMT+3 = 00:00 UTC)
0 0 * * * /usr/local/bin/backup.sh >> /var/log/cron.log 2>&1

# Будильник Supabase (09:17 GMT+3 = 06:17 UTC): раз в сутки запрос к
# /api/wiki/health, чтобы бесплатный проект с базой знаний не уходил в паузу
# от простоя. Проверка поля status, повторы и алерт — внутри wiki-wake.sh.
17 6 * * * /usr/local/bin/wiki-wake.sh >> /var/log/cron.log 2>&1

# Утренний цикл (8:00 GMT+3 = 05:00 UTC):
# 1. Создать меню на сегодня
# 2. Не-админам — короткое уведомление о меню
# 3. Админам — единый дайджест: расписание из Google Calendar + меню дня.
#    Бот отвечает 503, если дайджест не дошёл никому; недоставленное он сам
#    досылает */5-тиком до 12:00 GMT+3.
0 5 * * * { curl -sS -f --retry 3 --retry-connrefused -m 30 -X POST http://backend:8000/api/menus/create-daily -H "X-Cron-Secret: $CRON_SECRET" -H "Content-Type: application/json" -d '{}' || { /usr/local/bin/cron-alert.sh "⏰❌ create-daily провалился — меню не создано"; false; }; } >> /var/log/cron.log 2>&1 && { curl -sS -f --retry 3 --retry-connrefused -m 30 -X POST http://bot:8080/notify -H "X-Cron-Secret: $CRON_SECRET" -H "Content-Type: application/json" -d '{"event":"menu_created"}' || /usr/local/bin/cron-alert.sh "⏰❌ уведомление menu_created провалилось"; } >> /var/log/cron.log 2>&1 && { curl -sS -f --retry 3 --retry-connrefused -m 60 -X POST "http://bot:8080/check-calendar?digest=true" -H "X-Cron-Secret: $CRON_SECRET" || /usr/local/bin/cron-alert.sh "⏰❌ утренний дайджест провалился (бот дошлёт catch-up'ом до 12:00)"; } >> /var/log/cron.log 2>&1

# Финализировать список (13:00 GMT+3 = 10:00 UTC)
0 10 * * * { curl -sS -f --retry 3 --retry-connrefused -m 30 -X POST http://backend:8000/api/menus/finalize -H "X-Cron-Secret: $CRON_SECRET" -H "Content-Type: application/json" -d '{}' || { /usr/local/bin/cron-alert.sh "⏰❌ finalize провалился — голосование не открыто"; false; }; } >> /var/log/cron.log 2>&1 && { curl -sS -f --retry 3 --retry-connrefused -m 30 -X POST http://bot:8080/notify -H "X-Cron-Secret: $CRON_SECRET" -H "Content-Type: application/json" -d '{"event":"voting_opened"}' || /usr/local/bin/cron-alert.sh "⏰❌ уведомление voting_opened провалилось (бот дошлёт catch-up'ом)"; } >> /var/log/cron.log 2>&1

# Закрыть голосование (17:00 GMT+3 = 14:00 UTC)
0 14 * * * { curl -sS -f --retry 3 --retry-connrefused -m 30 -X POST http://backend:8000/api/menus/close-voting -H "X-Cron-Secret: $CRON_SECRET" -H "Content-Type: application/json" -d '{}' || { /usr/local/bin/cron-alert.sh "⏰❌ close-voting провалился — победитель не определён"; false; }; } >> /var/log/cron.log 2>&1 && { curl -sS -f --retry 3 --retry-connrefused -m 30 -X POST http://bot:8080/notify -H "X-Cron-Secret: $CRON_SECRET" -H "Content-Type: application/json" -d '{"event":"voting_closed"}' || /usr/local/bin/cron-alert.sh "⏰❌ уведомление voting_closed провалилось (бот дошлёт catch-up'ом)"; } >> /var/log/cron.log 2>&1

# Календарь: проверка часовых напоминаний и встроенных reminders каждые 5 минут;
# с 08:05 до 12:00 GMT+3 тик также досылает недоставленный утренний дайджест.
# Без алерта при провале: тик повторяется через 5 минут, а рестарт бота
# превращал бы каждую пропущенную минуту в спам админам.
*/5 * * * * curl -sS -f -m 60 -X POST http://bot:8080/check-calendar -H "X-Cron-Secret: $CRON_SECRET" >> /var/log/cron.log 2>&1
